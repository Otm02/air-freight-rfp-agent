# Copy to .env.local to enable Live LLM mode.
# If no API key is set, the app runs fully in deterministic Offline Mode.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional provider override: auto | gemini | openai | offline (default: auto)
LLM_PROVIDER=auto

# Local SQLite database URL via @libsql/client
DATABASE_URL=file:./data/rfp.db
