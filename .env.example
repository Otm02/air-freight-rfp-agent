# Copy to .env.local to enable Live LLM mode.
# If no API key is set, the app runs fully in deterministic Offline Mode.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional provider override: auto | gemini | openai | offline (default: auto)
LLM_PROVIDER=auto

# Optional rate-limit & per-run cost guardrails for live LLM calls
LLM_MAX_RPM=30
LLM_MAX_COST_USD_PER_RUN=0.50

# Local SQLite database URL via @libsql/client
DATABASE_URL=file:./data/rfp.db

# Optional SMTP delivery for outgoing customer quote emails.
# When unset, "send" stores emails in the in-app outbox (emails table) without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=rfp-response-team@carrier.example
